<?xml version="1.0" encoding="utf-8"?>
<!--
  Static app shortcuts, shown on long-press of the MaxedHealth home-screen
  icon. Added 25/09/26 to replace the temporary standalone "MH Health Connect
  Test" 4th icon — this is the "real flow" that icon was always meant to be
  folded into, without needing to build a whole in-launcher Settings screen
  just for this one toggle.

  shortcutShortLabel/shortcutLongLabel must be @string references, not raw
  text — Android's resource linker rejects a literal string here even though
  it's fine on almost every other attribute (confirmed 26/09/26 build error:
  "incompatible with attribute ... reference"). Labels now live in
  res/values/strings.xml instead.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="health_connect"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_health_connect_short"
        android:shortcutLongLabel="@string/shortcut_health_connect_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.maxedhealth.launcher"
            android:targetClass="com.maxedhealth.launcher.HealthConnectTestActivity" />
    </shortcut>
</shortcuts>
