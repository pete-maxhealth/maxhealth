<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Termux's own custom permission — a normal Android runtime "dangerous"
         permission dialog, same category as camera/location. This alone is NOT
         enough for RUN_COMMAND to actually execute — Termux also separately checks
         allow-external-apps=true in its own termux.properties, which we cannot set
         ourselves (see ProvisioningActivity.kt for why, and the one-time manual step
         that's genuinely unavoidable). -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Needed to write provision.sh and the sentinel file into shared storage where
         both our app and Termux can see them. On Android 11+ this is the
         "Files and media -> Allow management of all files" flavour, requested at
         runtime in ProvisioningActivity, not just declared here. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground service for Health Connect background sync (29/09/26) — replaces
         WorkManager's periodic job, which never fired once on Pete's phone despite
         battery saver being off (confirmed via Logcat: other apps' periodic workers
         fired normally in the same window, ours never did). FOREGROUND_SERVICE_DATA_SYNC
         is the Android 14+ specific type required alongside the general permission —
         "dataSync" (not "health") because this service reads from Health Connect
         (already permission-gated separately) and writes to a file, rather than
         reading live sensors itself; "health" additionally requires
         ACTIVITY_RECOGNITION/BODY_SENSORS/HIGH_SAMPLING_RATE_SENSORS, confirmed via a
         real SecurityException on Pete's phone when first tried. See
         HealthConnectSyncService.kt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Lets the alarm-based re-scheduling survive Doze/App Standby — needed on
         Android 12+ for AlarmManager.setExactAndAllowWhileIdle(). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 02/10/26 - USE_EXACT_ALARM is auto-granted at install (API 33+) and cannot be revoked,
         so a reinstall can no longer leave the 30-min alarm inexact. Fine for a sideloaded app. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Re-arms the sync alarm after a reboot — AlarmManager alarms don't survive a
         restart on their own. See AlarmReceiver.kt. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Health Connect: read-only for now (steps, heart rate, weight, sleep).
         These are Android's own "health permissions" group, requested at
         runtime through Health Connect's own permission screen (not the usual
         Android dialog) — see HealthConnectBridge.kt. minSdk doesn't need
         raising: Health Connect handles an unsupported/missing device
         gracefully via HealthConnectClient.getSdkStatus(). -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <!-- 30/09/26 — three more, matching the three new record types
         HealthConnectBridge.kt now reads (HRV, SpO2, active calories). Without
         these declared here, Health Connect's own permission screen would never
         offer them, however many record-type permissions the Kotlin code asks
         for at runtime — the manifest is the ceiling on what CAN be requested. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />

    <!-- Deliberately NOT using QUERY_ALL_PACKAGES (a blunt, Play-Store-unfriendly
         permission) to check whether Termux/Termux:Boot/Termux:API are installed —
         the <queries> block below is the narrower, modern way to ask about
         specifically these three packages and nothing else. -->
    <queries>
        <package android:name="com.termux" />
        <package android:name="com.termux.boot" />
        <package android:name="com.termux.api" />
        <!-- Health Connect: two different package names depending on Android
             version (confirmed on Pete's phone, 23/09/26 — both present):
             the modern OS-integrated one (Android 14+) and the legacy
             separate Play Store app (Android <14). Declaring both so we can
             detect whichever is actually active. -->
        <package android:name="com.google.android.healthconnect.controller" />
        <package android:name="com.google.android.apps.healthdata" />

        <!-- The permission-request screen itself is launched via this action, not
             a package name — package visibility (Android 11+) blocks resolving
             it unless the action itself is also declared here, separately from
             the <package> entries above. This was the actual cause of the
             permission screen never appearing (confirmed 23/09/26 — no crash,
             no screen, "Granted: 0 of 4" every time). -->
        <intent>
            <action android:name="androidx.health.connect.action.REQUEST_PERMISSIONS" />
        </intent>

        <!-- Lets us ask "which installed app handles this exact URL?" (used to find
             Pete/Jill/anyone's own installed WebAPK dynamically, instead of one
             person's package name hardcoded — see findInstalledWebApk() in
             MainActivity.kt, added 25/09/26). Without this declaration,
             queryIntentActivities() for an explicit http VIEW intent returns
             nothing on Android 11+, same package-visibility reasoning as above. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <!-- 30/09/26 — renamed from plain "MaxedHealth" to "MaxedHealth Sync". Sitting in
         the app drawer right next to the actual MaxedHealth PWA (a separate, Chrome-
         installed app with the same generic name), two identically-labelled
         "MaxedHealth" entries look like an accidental duplicate — something a future
         Pete or Jill could reasonably tap to clean up. It isn't a duplicate: this app
         is what runs the Health Connect background sync (see
         HealthConnectSyncService's doc comment), and deleting it would silently stop
         that. "Sync" in the label is the one-word explanation of what makes this one
         different, readable at a glance without needing to open it. android:description
         adds the fuller explanation, shown on this app's own "App info" page in
         Settings for anyone who taps through wanting more than the label alone. -->
    <application
        android:label="MaxedHealth Sync"
        android:description="@string/app_description"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic is required for the WebView to reach
             http://localhost:5757 — this is a plain-HTTP loopback address, not
             traffic leaving the device, so this is safe here despite normally
             being something to avoid. -->

        <activity
            android:name=".ProvisioningActivity"
            android:exported="true"
            android:theme="@style/Theme.MaxedHealthLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the home-screen icon to reach Health Connect settings —
                 replaces the old standalone 4th icon below (25/09/26). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.MaxedHealthLauncher" />

        <!-- No longer its own launcher icon (25/09/26) — reachable via a
             long-press shortcut on the main icon instead (see the
             android.app.shortcuts meta-data on ProvisioningActivity above and
             res/xml/shortcuts.xml). Still exported=true: shortcuts launch a
             component directly, same requirement as before. -->
        <activity
            android:name=".HealthConnectTestActivity"
            android:exported="true"
            android:label="MaxedHealth: Health Connect"
            android:theme="@style/Theme.MaxedHealthLauncher">
        </activity>

        <!-- MANDATORY per Health Connect's own docs for Android 14+ (Pete is on
             Android 15) — without this exact declaration, Health Connect
             silently refuses to show its permission screen at all: no crash,
             no screen, request just returns nothing granted every time. This
             was the actual cause of tonight's "Granted: 0 of 4" loop, not a
             missing package-visibility <queries> entry (that was a real but
             smaller fix, kept above as well since it's still correct).
             https://developer.android.com/health-and-fitness/health-connect/get-started -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".HealthConnectTestActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Foreground-service replacement for WorkManager background sync (29/09/26) —
             see HealthConnectSyncService.kt's doc comment for why. exported=false: only
             this app itself ever starts it. foregroundServiceType="dataSync" is
             mandatory on Android 14+ and must match FOREGROUND_SERVICE_DATA_SYNC above
             and ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC in code, or starting the
             service throws at runtime (confirmed both ways on Pete's phone: a missing
             declaration throws MissingForegroundServiceTypeException, and the wrong
             type — "health" was tried first — throws its own SecurityException). -->
        <service
            android:name=".HealthConnectSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Fires every 30 min (armed by the service above) and on boot, so the sync
             chain survives a reboot without needing the app reopened. See
             AlarmReceiver.kt. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
